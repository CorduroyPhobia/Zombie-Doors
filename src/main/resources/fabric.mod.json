{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "sources": "https://github.com/CorduroyPhobia/Zombie-Doors",
    "issues": "https://github.com/CorduroyPhobia/Zombie-Doors/issues"
  },
  "icon": "assets/${mod_id}/icon.png",
  "license": "${license_id}",
  "environment": "*",
  "entrypoints": {
    "main": ["${maven_group}.ZombieDoors"],
    "client": ["${maven_group}.client.ZombieDoorsClient"],
    "modmenu": ["${maven_group}.client.ZombieDoorsModMenuIntegration"]
  },
  "mixins": ["zombiedoors.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=25",
    "fabric-api": ">=${fabric_api_version}"
  },
  "suggests": {
    "cloth-config": ">=${cloth_config_version}",
    "modmenu": ">=${modmenu_version}"
  }
}
